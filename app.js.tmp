let TOKEN = localStorage.getItem('sms_token') || '';
let ME = JSON.parse(localStorage.getItem('sms_user') || 'null');
const $ = (id) => document.getElementById(id);
const money = (n) => Number(n || 0).toLocaleString();
const flagCls = (f) => 'flag ' + String(f || '').replace(/ /g, '.');

// ---- Standard vector icons (feather-style, no emojis) ----
